/* =========================================================
   ACTIVE NAV
========================================================= */

const observer=
    new IntersectionObserver(
        entries=>{

            entries.forEach(entry=>{

                if(entry.isIntersecting){

                    const index=
                        [...pages].indexOf(
                            entry.target
                        );

                    document
                        .querySelectorAll(
                            ".nav-links button"
                        )
                        .forEach(btn=>{

                            btn.classList.toggle(
                                "active",
                                Number(
                                    btn.dataset.page
                                )===index
                            );

                        });

                }

            });

        },
        {
            threshold:.45
        }
    );

pages.forEach(page=>
    observer.observe(page)
);

/* =========================================================
   SIMPLE MUSIC ENGINE
========================================================= */

let audioContext=null;
let musicOn=false;
let musicTimer=null;

const soundBtn=
    document.getElementById(
        "soundBtn"
    );

function playTone(){

    if(!musicOn)
        return;

    if(!audioContext){

        audioContext=
            new (
                window.AudioContext ||
                window.webkitAudioContext
            )();

    }

    const notes=[
        261.63,
        329.63,
        392,
        523.25
    ];

    const oscillator=
        audioContext.createOscillator();

    const gain=
        audioContext.createGain();

    oscillator.type="sine";

    oscillator.frequency.value=
        notes[
            Math.floor(
                Math.random()*
                notes.length
            )
        ];

    gain.gain.setValueAtTime(
        .0001,
        audioContext.currentTime
    );

    gain.gain.exponentialRampToValueAtTime(
        .045,
        audioContext.currentTime+.04
    );

    gain.gain.exponentialRampToValueAtTime(
        .0001,
        audioContext.currentTime+.8
    );

    oscillator.connect(gain);

    gain.connect(
        audioContext.destination
    );

    oscillator.start();

    oscillator.stop(
        audioContext.currentTime+.8
    );

}

if(soundBtn){

    soundBtn.addEventListener(
        "click",
        async()=>{

            if(!audioContext){

                audioContext=
                    new (
                        window.AudioContext ||
                        window.webkitAudioContext
                    )();

            }

            if(
                audioContext.state===
                "suspended"
            ){

                await audioContext.resume();

            }

            musicOn=!musicOn;

            soundBtn.innerHTML=
                musicOn
                    ?"♫"
                    :"×";

            if(musicOn){

                playTone();

                if(musicTimer){
                    clearInterval(
                        musicTimer
                    );
                }

                musicTimer=
                    setInterval(
                        playTone,
                        950
                    );

            }else{

                if(musicTimer){

                    clearInterval(
                        musicTimer
                    );

                    musicTimer=null;

                }

            }

        }
    );

}

