/* =========================================================
   LETTER — FIXED 3D ENVELOPE SYSTEM
========================================================= */

const letterBtn=
    document.getElementById("letterBtn");

const envelope=
    document.getElementById("envelope");

let letterOpening=false;

/*
   The envelope starts CLOSED.
   Clicking once:
   1. opens flap
   2. lets the letter emerge
   3. creates a heart burst
*/

if(letterBtn && envelope){

    letterBtn.addEventListener(
        "click",
        ()=>{

            /*
               Prevent rapid double clicks while the
               3D animation is running.
            */

            if(letterOpening){
                return;
            }

            letterOpening=true;

            const isOpen=
                envelope.classList.contains("open");

            if(!isOpen){

                envelope.classList.add("open");

                letterBtn.textContent=
                    "My heart is open ♡";

                /*
                   Give the flap a moment to open before
                   bringing the paper fully upward.
                */

                if(window.gsap){

                    gsap.fromTo(
                        envelope,
                        {
                            rotateX:0,
                            rotateY:0
                        },
                        {
                            rotateX:1.5,
                            rotateY:-1.5,
                            duration:.55,
                            yoyo:true,
                            repeat:1,
                            ease:"power2.inOut"
                        }
                    );

                }

                setTimeout(()=>{

                    burstHearts(
                        window.innerWidth/2,
                        window.innerHeight/2
                    );

                },650);

                /*
                   Animation is long enough to make the
                   paper movement feel physical.
                */

                setTimeout(()=>{

                    letterOpening=false;

                },1550);

            }else{

                /*
                   Second click closes everything again.
                   This makes the interaction reversible.
                */

                envelope.classList.remove(
                    "open"
                );

                letterBtn.textContent=
                    "Open my heart ♡";

                setTimeout(()=>{

                    letterOpening=false;

                },1200);

            }

        }
    );

}

/* =========================================================
   HEART BURST
========================================================= */

function burstHearts(x,y){

    for(let i=0;i<30;i++){

        const heart=
            document.createElement("div");

        heart.className=
            "heart";

        heart.innerHTML=
            Math.random()>.5
                ?"♥"
                :"♡";

        heart.style.left=
            x+"px";

        heart.style.top=
            y+"px";

        const angle=
            Math.random()*Math.PI*2;

        const distance=
            50+Math.random()*250;

        document.body.appendChild(
            heart
        );

        if(window.gsap){

            gsap.to(heart,{

                x:
                    Math.cos(angle)*
                    distance,

                y:
                    Math.sin(angle)*
                    distance,

                scale:
                    Math.random()*1.5+.5,

                opacity:0,

                duration:
                    1.5+Math.random(),

                ease:"power2.out",

                onComplete:()=>{
                    heart.remove();
                }

            });

        }else{

            heart.remove();

        }

    }

}

