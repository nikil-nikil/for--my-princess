<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#ff4fa3">
<meta name="description" content="A magical birthday experience made with love.">

<title>For My Princess ♡</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@300;400;500;600;700&family=Great+Vibes&family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<style>

/* =========================================================
   GLOBAL
========================================================= */

:root{
    --pink:#ff4fa3;
    --hot:#ff1688;
    --rose:#ff8cc8;
    --soft:#ffd6ec;
    --cream:#fff8fc;
    --dark:#220c1b;
    --purple:#9d5cff;
    --gold:#f4c76b;
    --glass:rgba(255,255,255,.11);
    --border:rgba(255,255,255,.25);
    --shadow:0 30px 100px rgba(107,0,55,.25);
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
    overflow-x:hidden;
}

body{
    background:#fff5fb;
    color:var(--dark);
    font-family:'DM Sans',sans-serif;
    overflow-x:hidden;
    cursor:none;
}

button,
a{
    cursor:none;
}

::selection{
    background:var(--pink);
    color:white;
}

button{
    font-family:inherit;
}

/* =========================================================
   CURSOR
========================================================= */

.cursor{
    position:fixed;
    width:12px;
    height:12px;
    border-radius:50%;
    background:white;
    mix-blend-mode:difference;
    pointer-events:none;
    z-index:99999;
    transform:translate(-50%,-50%);
}

.cursor-ring{
    position:fixed;
    width:42px;
    height:42px;
    border:1px solid rgba(255,79,163,.8);
    border-radius:50%;
    pointer-events:none;
    z-index:99998;
    transform:translate(-50%,-50%);
    transition:width .3s,height .3s,background .3s;
}

/* =========================================================
   LOADER
========================================================= */

.loader{
    position:fixed;
    inset:0;
    background:
        radial-gradient(circle at 50% 40%,#ff7fba,#ff4fa3 35%,#7e1555 100%);
    z-index:999999;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    color:white;
}

.loader-heart{
    font-size:70px;
    animation:heartBeat 1s infinite;
    filter:drop-shadow(0 0 30px white);
}

.loader-title{
    margin-top:20px;
    font-family:'Great Vibes',cursive;
    font-size:42px;
    text-align:center;
    padding:0 20px;
}

.loader-bar{
    margin-top:25px;
    width:180px;
    height:2px;
    background:rgba(255,255,255,.25);
    overflow:hidden;
}

.loader-bar span{
    display:block;
    height:100%;
    width:0;
    background:white;
    animation:load 2.3s forwards;
}

@keyframes load{
    to{width:100%}
}

@keyframes heartBeat{
    0%,100%{transform:scale(1)}
    25%{transform:scale(1.15)}
    45%{transform:scale(1)}
}

/* =========================================================
   NAV
========================================================= */

.nav{
    position:fixed;
    top:18px;
    left:50%;
    transform:translateX(-50%);
    width:min(92%,1100px);
    height:64px;
    border:1px solid rgba(255,255,255,.28);
    background:rgba(255,255,255,.12);
    backdrop-filter:blur(20px);
    -webkit-backdrop-filter:blur(20px);
    border-radius:100px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 22px;
    z-index:5000;
    box-shadow:0 20px 50px rgba(74,0,40,.08);
}

.logo{
    font-family:'Great Vibes',cursive;
    font-size:29px;
    color:#fff;
    text-shadow:0 4px 20px rgba(255,0,120,.5);
    white-space:nowrap;
}

.nav-links{
    display:flex;
    gap:3px;
    overflow-x:auto;
    scrollbar-width:none;
}

.nav-links::-webkit-scrollbar{
    display:none;
}

.nav-links button{
    border:0;
    background:transparent;
    color:white;
    padding:10px 11px;
    border-radius:30px;
    font-size:10px;
    font-weight:700;
    letter-spacing:1px;
    transition:.3s;
    white-space:nowrap;
}

.nav-links button:hover,
.nav-links button.active{
    background:rgba(255,255,255,.2);
}

.sound{
    flex-shrink:0;
    width:38px;
    height:38px;
    border:1px solid rgba(255,255,255,.3);
    border-radius:50%;
    background:rgba(255,255,255,.1);
    color:white;
    display:grid;
    place-items:center;
}

/* =========================================================
   COMMON
========================================================= */

.page{
    min-height:100svh;
    position:relative;
    overflow:hidden;
}

.container{
    width:min(1180px,90%);
    margin:auto;
    position:relative;
    z-index:5;
}

.eyebrow{
    text-transform:uppercase;
    letter-spacing:5px;
    font-size:11px;
    font-weight:700;
    opacity:.7;
}

.section-title{
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(55px,9vw,125px);
    line-height:.82;
    font-weight:500;
}

.script{
    font-family:'Great Vibes',cursive;
    color:var(--pink);
}

.glow{
    text-shadow:
        0 0 10px rgba(255,255,255,.8),
        0 0 30px rgba(255,79,163,.6),
        0 0 70px rgba(255,79,163,.3);
}

.btn{
    border:0;
    padding:15px 27px;
    border-radius:50px;
    background:white;
    color:var(--hot);
    font-weight:800;
    letter-spacing:.5px;
    box-shadow:0 15px 40px rgba(255,0,120,.18);
    transition:.35s;
    position:relative;
    z-index:10;
}

.btn:hover{
    transform:translateY(-5px) scale(1.03);
    box-shadow:0 25px 55px rgba(255,0,120,.3);
}

.outline-btn{
    background:transparent;
    color:white;
    border:1px solid rgba(255,255,255,.5);
}

/* =========================================================
   PARTICLES
========================================================= */

#particles{
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:2;
}

.spark{
    position:absolute;
    width:3px;
    height:3px;
    background:white;
    border-radius:50%;
    box-shadow:0 0 12px white;
    animation:floatSpark linear infinite;
}

@keyframes floatSpark{
    from{
        transform:translateY(100vh) scale(.2);
        opacity:0;
    }

    15%{opacity:1}

    85%{opacity:1}

    to{
        transform:translateY(-10vh) scale(1);
        opacity:0;
    }
}

/* =========================================================
   3D CANVAS
========================================================= */

#three-bg{
    position:absolute;
    inset:0;
    z-index:1;
}

/* =========================================================
   PAGE 1 — OPENING
========================================================= */

.hero{
    min-height:100svh;
    background:
        radial-gradient(circle at 20% 20%,rgba(255,255,255,.28),transparent 22%),
        radial-gradient(circle at 80% 20%,rgba(255,190,225,.2),transparent 20%),
        linear-gradient(135deg,#ff76b9,#ec318d 45%,#7f195a);
    color:white;
    display:flex;
    align-items:center;
}

.hero::before{
    content:"";
    position:absolute;
    width:600px;
    height:600px;
    border-radius:50%;
    background:rgba(255,255,255,.09);
    filter:blur(2px);
    top:-250px;
    right:-150px;
}

.hero-content{
    padding-top:50px;
    text-align:center;
}

.hero-small{
    opacity:.8;
    letter-spacing:6px;
    font-size:11px;
    text-transform:uppercase;
}

.hero-title{
    margin:20px auto;
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(70px,14vw,190px);
    line-height:.7;
    font-weight:500;
    perspective:1000px;
}

.hero-title span{
    display:inline-block;
    text-shadow:
        0 2px 0 #c72870,
        0 4px 0 #ad2162,
        0 8px 20px rgba(0,0,0,.25);
    animation:letterFloat 4s ease-in-out infinite;
}

.hero-title span:nth-child(2){animation-delay:.1s}
.hero-title span:nth-child(3){animation-delay:.2s}
.hero-title span:nth-child(4){animation-delay:.3s}
.hero-title span:nth-child(5){animation-delay:.4s}

@keyframes letterFloat{
    0%,100%{transform:translateY(0) rotateX(0)}
    50%{transform:translateY(-12px) rotateX(8deg)}
}

.hero-sub{
    max-width:500px;
    margin:25px auto 35px;
    font-size:15px;
    line-height:1.8;
    opacity:.86;
}

.scroll-hint{
    position:absolute;
    bottom:30px;
    left:50%;
    transform:translateX(-50%);
    font-size:10px;
    letter-spacing:4px;
    opacity:.65;
}

/* =========================================================
   PAGE 2 — HER
========================================================= */

.her{
    background:#fff7fc;
    display:flex;
    align-items:center;
}

.her .container{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:80px;
    align-items:center;
}

.photo-orbit{
    position:relative;
    width:min(450px,80vw);
    aspect-ratio:1;
    margin:auto;
}

.photo-main{
    position:absolute;
    inset:9%;
    border-radius:45% 55% 50% 50%;
    overflow:hidden;
    border:8px solid white;
    box-shadow:var(--shadow);
    transform:rotate(-5deg);
}

.photo-main img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:transform 1s;
}

.photo-main:hover img{
    transform:scale(1.08);
}

.orbit{
    position:absolute;
    inset:0;
    border:1px dashed rgba(255,79,163,.35);
    border-radius:50%;
    animation:spin 18s linear infinite;
}

.orbit-dot{
    position:absolute;
    width:20px;
    height:20px;
    border-radius:50%;
    background:var(--pink);
    box-shadow:0 0 30px var(--pink);
    top:10%;
    left:15%;
}

.orbit-dot.two{
    top:auto;
    left:auto;
    right:8%;
    bottom:25%;
    width:12px;
    height:12px;
}

.floating-heart{
    position:absolute;
    color:var(--pink);
    font-size:30px;
    animation:heartFloat 4s ease-in-out infinite;
}

.h1{top:5%;right:10%}
.h2{bottom:5%;left:4%;animation-delay:1s}
.h3{top:45%;right:-4%;animation-delay:2s}

@keyframes spin{
    to{transform:rotate(360deg)}
}

@keyframes heartFloat{
    0%,100%{transform:translateY(0) rotate(-10deg)}
    50%{transform:translateY(-20px) rotate(10deg)}
}

.her-copy h2{
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(55px,7vw,100px);
    line-height:.8;
    font-weight:500;
    margin:15px 0 25px;
}

.her-copy p{
    max-width:470px;
    line-height:1.8;
    color:#7e6370;
    font-size:14px;
}

.mini-stats{
    display:flex;
    gap:35px;
    margin-top:35px;
}

.stat strong{
    font-family:'Cormorant Garamond',serif;
    font-size:38px;
    color:var(--pink);
    display:block;
}

.stat span{
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:2px;
}

/* =========================================================
   PAGE 3 — MEMORIES
========================================================= */

.memories{
    background:
        radial-gradient(circle at 15% 20%,#ffd2ea,transparent 28%),
        radial-gradient(circle at 85% 80%,#e5c9ff,transparent 28%),
        #fff;
    padding:130px 0;
}

.memory-heading{
    text-align:center;
    margin-bottom:70px;
}

.memory-heading h2{
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(60px,9vw,110px);
    font-weight:500;
    line-height:.8;
}

.memory-grid{
    display:grid;
    grid-template-columns:repeat(12,1fr);
    gap:22px;
}

.memory{
    position:relative;
    overflow:hidden;
    border-radius:28px;
    min-height:330px;
    box-shadow:0 20px 60px rgba(100,20,70,.13);
    transform-style:preserve-3d;
    transition:.6s;
}

.memory:hover{
    transform:translateY(-12px) rotateX(4deg) rotateY(-3deg);
}

.memory:nth-child(1){grid-column:span 5}
.memory:nth-child(2){grid-column:span 7}
.memory:nth-child(3){grid-column:span 7}
.memory:nth-child(4){grid-column:span 5}

.memory img{
    width:100%;
    height:100%;
    min-height:330px;
    object-fit:cover;
    transition:1s;
}

.memory:hover img{
    transform:scale(1.08);
}

.memory-overlay{
    position:absolute;
    inset:0;
    background:linear-gradient(transparent 40%,rgba(30,0,20,.7));
    display:flex;
    align-items:flex-end;
    padding:25px;
    color:white;
}

.memory-overlay span{
    font-family:'Great Vibes',cursive;
    font-size:32px;
}

/* =========================================================
   PAGE 4 — LOVE STORY
========================================================= */

.story{
    background:
        radial-gradient(circle at 50% 20%,rgba(255,180,220,.2),transparent 30%),
        linear-gradient(135deg,#190817,#4e1642 55%,#160614);
    color:white;
    display:flex;
    align-items:center;
}

.story-title{
    text-align:center;
    margin-bottom:45px;
}

.story-title h2{
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(55px,8vw,100px);
    line-height:.8;
    font-weight:500;
}

.story-stage{
    position:relative;
    height:420px;
    border-radius:40px;
    overflow:hidden;
    background:
        radial-gradient(circle at 50% 25%,rgba(255,255,255,.12),transparent 15%),
        linear-gradient(#250c27,#10050f);
    border:1px solid rgba(255,255,255,.15);
    box-shadow:0 30px 100px rgba(0,0,0,.4);
}

.moon{
    position:absolute;
    width:120px;
    height:120px;
    border-radius:50%;
    background:#fff7df;
    right:13%;
    top:35px;
    box-shadow:0 0 60px rgba(255,247,220,.5);
}

.stars{
    position:absolute;
    inset:0;
}

.star{
    position:absolute;
    width:3px;
    height:3px;
    background:white;
    border-radius:50%;
    animation:twinkle 2s infinite alternate;
}

@keyframes twinkle{
    to{opacity:.2;transform:scale(.5)}
}

.ground{
    position:absolute;
    bottom:0;
    left:0;
    width:100%;
    height:105px;
    background:linear-gradient(#301331,#120812);
    border-top:1px solid rgba(255,255,255,.1);
}

.castle{
    position:absolute;
    bottom:60px;
    left:50%;
    transform:translateX(-50%);
    width:180px;
    height:120px;
    background:#ead4e2;
    border-radius:8px 8px 0 0;
    box-shadow:0 0 40px rgba(255,150,220,.15);
}

.tower{
    position:absolute;
    bottom:0;
    width:45px;
    height:170px;
    background:#e8cbdc;
}

.tower:before{
    content:"";
    position:absolute;
    top:-30px;
    left:-8px;
    border-left:30px solid transparent;
    border-right:30px solid transparent;
    border-bottom:35px solid #b85f9b;
}

.tower.left{left:-28px}
.tower.right{right:-28px}

.door{
    position:absolute;
    bottom:0;
    left:50%;
    transform:translateX(-50%);
    width:35px;
    height:60px;
    background:#6b2c5c;
    border-radius:30px 30px 0 0;
}

.princess,
.prince{
    position:absolute;
    bottom:72px;
    width:70px;
    height:145px;
    transition:2s;
}

.princess{left:16%}
.prince{right:16%}

.person-head{
    position:absolute;
    top:0;
    left:50%;
    transform:translateX(-50%);
    width:36px;
    height:36px;
    border-radius:50%;
    background:#f2b08d;
    z-index:3;
}

.princess .person-head:before{
    content:"";
    position:absolute;
    inset:-12px;
    background:#d78a3c;
    border-radius:50%;
    z-index:-1;
}

.prince .person-head:before{
    content:"";
    position:absolute;
    top:-5px;
    left:0;
    width:36px;
    height:18px;
    background:#382033;
    border-radius:50% 50% 10px 10px;
}

.body{
    position:absolute;
    top:38px;
    left:50%;
    transform:translateX(-50%);
    width:55px;
    height:100px;
    border-radius:28px 28px 8px 8px;
}

.princess .body{
    background:linear-gradient(120deg,#ff75b8,#9b2e9d);
    clip-path:polygon(30% 0,70% 0,100% 100%,0 100%);
}

.prince .body{
    background:linear-gradient(120deg,#25283c,#10111b);
    clip-path:polygon(25% 0,75% 0,100% 100%,0 100%);
}

.princess:after,
.prince:after{
    content:"";
    position:absolute;
    bottom:-7px;
    left:10px;
    width:18px;
    height:45px;
    background:#f2b08d;
    box-shadow:30px 0 #f2b08d;
    border-radius:10px;
}

.love-path{
    position:absolute;
    width:35%;
    height:1px;
    background:linear-gradient(90deg,transparent,var(--pink),transparent);
    left:32.5%;
    bottom:135px;
}

.meet-heart{
    position:absolute;
    left:50%;
    bottom:160px;
    transform:translateX(-50%) scale(0);
    font-size:45px;
    filter:drop-shadow(0 0 20px #ff4fa3);
}

.story-stage.meet .princess{
    left:38%;
}

.story-stage.meet .prince{
    right:38%;
}

.story-stage.meet .meet-heart{
    animation:meetHeart 1.2s forwards .8s;
}

@keyframes meetHeart{
    0%{transform:translateX(-50%) scale(0)}
    60%{transform:translateX(-50%) scale(1.3)}
    100%{transform:translateX(-50%) scale(1)}
}

/* =========================================================
   PAGE 5 — REASONS
========================================================= */

.reasons{
    background:#fff7fc;
    padding:120px 0;
}

.reasons-heading{
    text-align:center;
}

.reasons-heading h2{
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(60px,9vw,110px);
    font-weight:500;
    line-height:.8;
}

.reason-grid{
    margin-top:70px;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
}

.reason{
    min-height:300px;
    padding:35px;
    border-radius:35px;
    background:linear-gradient(145deg,rgba(255,255,255,.9),rgba(255,222,240,.5));
    border:1px solid rgba(255,79,163,.12);
    box-shadow:0 25px 70px rgba(145,20,85,.08);
    transform-style:preserve-3d;
    transition:.5s;
}

.reason:hover{
    transform:translateY(-12px) rotateY(8deg);
}

.reason-number{
    font-family:'Cormorant Garamond',serif;
    font-size:70px;
    color:#ffc2df;
}

.reason-icon{
    font-size:45px;
    margin:10px 0 20px;
}

.reason h3{
    font-family:'Cormorant Garamond',serif;
    font-size:34px;
    margin-bottom:12px;
}

.reason p{
    color:#866b79;
    line-height:1.7;
    font-size:13px;
}

/* =========================================================
   PAGE 6 — MY WISHES
========================================================= */

.wishes-page{
    min-height:100svh;
    background:
        radial-gradient(circle at 50% 15%,rgba(115,74,190,.35),transparent 30%),
        radial-gradient(circle at 20% 80%,rgba(255,79,163,.12),transparent 25%),
        linear-gradient(145deg,#050313,#100522 45%,#17051c);
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:120px 0 80px;
}

.wishes-heading{
    text-align:center;
    margin-bottom:35px;
    position:relative;
    z-index:20;
}

.wishes-heading h2{
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(60px,9vw,110px);
    line-height:.78;
    font-weight:500;
}

.wishes-instruction{
    margin-top:20px;
    font-size:clamp(13px,2vw,16px);
    letter-spacing:1px;
    color:rgba(255,255,255,.78);
    text-transform:lowercase;
}

.star-box{
    position:relative;
    width:min(1100px,94vw);
    height:min(620px,70svh);
    min-height:460px;
    margin:auto;
    overflow:hidden;
    border-radius:38px;
    border:1px solid rgba(255,255,255,.16);
    background:
        radial-gradient(circle at 70% 25%,rgba(125,82,210,.15),transparent 25%),
        radial-gradient(circle at 25% 70%,rgba(255,80,163,.1),transparent 25%),
        linear-gradient(160deg,#08051a,#03020d);
    box-shadow:
        0 40px 120px rgba(0,0,0,.55),
        inset 0 0 100px rgba(130,70,220,.08);
    transform-style:preserve-3d;
    perspective:1200px;
}

/* =========================================================
   BACKGROUND STARS
========================================================= */

.sky-stars{
    position:absolute;
    inset:0;
    pointer-events:none;
}

.sky-dot{
    position:absolute;
    width:2px;
    height:2px;
    background:#fff;
    border-radius:50%;
    opacity:.45;
    box-shadow:
        0 0 4px rgba(255,255,255,.75),
        0 0 10px rgba(255,255,255,.35);
    animation-name:realisticSkyTwinkle;
    animation-timing-function:ease-in-out;
    animation-iteration-count:infinite;
    will-change:opacity,transform;
}

@keyframes realisticSkyTwinkle{

    0%{
        opacity:.18;
        transform:scale(.72);
        filter:brightness(.8);
    }

    18%{
        opacity:.38;
        transform:scale(.86);
        filter:brightness(.95);
    }

    43%{
        opacity:.95;
        transform:scale(1.18);
        filter:brightness(1.3);
    }

    57%{
        opacity:1;
        transform:scale(1.32);
        filter:brightness(1.45);
    }

    72%{
        opacity:.48;
        transform:scale(.92);
        filter:brightness(1);
    }

    100%{
        opacity:.16;
        transform:scale(.68);
        filter:brightness(.8);
    }
}

.sky-dot.subtle{
    animation-name:subtleSkyTwinkle;
}

@keyframes subtleSkyTwinkle{

    0%,100%{
        opacity:.22;
        transform:scale(.75);
    }

    45%{
        opacity:.65;
        transform:scale(1);
    }

    58%{
        opacity:.9;
        transform:scale(1.12);
    }

    75%{
        opacity:.35;
        transform:scale(.86);
    }
}

/* =========================================================
   SHOOTING STARS
========================================================= */

.shooting-star{
    position:absolute;
    width:150px;
    height:5px;
    z-index:15;
    cursor:pointer;
    transform-origin:right center;
    transform-style:preserve-3d;
    pointer-events:auto;
    user-select:none;
    -webkit-tap-highlight-color:transparent;
    will-change:transform,opacity;
}

.shooting-star::before{
    content:"";
    position:absolute;
    right:0;
    top:50%;
    width:16px;
    height:16px;
    transform:translateY(-50%);
    border-radius:50%;
    background:
        radial-gradient(circle,#fff 0 15%,#fff6fc 25%,#ffb7df 50%,rgba(255,79,163,.15) 75%,transparent 100%);
    box-shadow:
        0 0 10px #fff,
        0 0 25px #ffb6e1,
        0 0 50px rgba(255,79,163,.9);
    z-index:3;
}

.shooting-star::after{
    content:"";
    position:absolute;
    right:10px;
    top:50%;
    width:145px;
    height:3px;
    transform:translateY(-50%);
    transform-origin:right;
    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,.05) 18%,
            rgba(255,190,225,.18) 42%,
            rgba(255,215,240,.65) 75%,
            white
        );
    filter:
        blur(.4px)
        drop-shadow(0 0 8px rgba(255,170,220,.9));
    border-radius:100%;
}

.shooting-star:hover{
    filter:brightness(1.35);
}

.shooting-star:hover::before{
    transform:translateY(-50%) scale(1.25);
}

.shooting-star.catching{
    pointer-events:none;
}

.star-particle{
    position:absolute;
    width:5px;
    height:5px;
    border-radius:50%;
    background:#fff;
    pointer-events:none;
    z-index:20;
    box-shadow:0 0 12px #ff9ed1;
}

.catch-hint{
    position:absolute;
    bottom:18px;
    left:50%;
    transform:translateX(-50%);
    color:rgba(255,255,255,.35);
    font-size:9px;
    letter-spacing:3px;
    text-transform:uppercase;
    z-index:25;
    pointer-events:none;
}

/* =========================================================
   PROMISE MODAL
========================================================= */

.promise-overlay{
    position:fixed;
    inset:0;
    z-index:8000;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:25px;
    background:rgba(2,0,12,.72);
    backdrop-filter:blur(15px);
    -webkit-backdrop-filter:blur(15px);
    opacity:0;
    visibility:hidden;
    transition:.45s;
}

.promise-overlay.show{
    opacity:1;
    visibility:visible;
}

.promise-card{
    width:min(520px,92vw);
    min-height:310px;
    padding:45px 35px;
    position:relative;
    border-radius:35px;
    text-align:center;
    background:
        radial-gradient(circle at 50% 0%,rgba(255,255,255,.16),transparent 40%),
        linear-gradient(145deg,rgba(43,18,63,.98),rgba(13,5,27,.98));
    border:1px solid rgba(255,255,255,.2);
    box-shadow:
        0 40px 120px rgba(0,0,0,.7),
        inset 0 0 50px rgba(255,79,163,.08);
    transform:translateY(30px) rotateX(10deg) scale(.85);
    transition:.65s cubic-bezier(.2,.8,.2,1);
    transform-style:preserve-3d;
}

.promise-overlay.show .promise-card{
    transform:translateY(0) rotateX(0) scale(1);
}

.promise-star{
    font-size:45px;
    display:block;
    margin-bottom:15px;
    color:#fff;
    text-shadow:
        0 0 15px #fff,
        0 0 35px #ff86c6,
        0 0 60px #ff4fa3;
    animation:promiseStarFloat 2s ease-in-out infinite;
}

@keyframes promiseStarFloat{
    50%{transform:translateY(-8px) scale(1.08)}
}

.promise-label{
    font-size:9px;
    letter-spacing:4px;
    text-transform:uppercase;
    color:rgba(255,255,255,.55);
}

.promise-message{
    margin:20px auto 25px;
    max-width:420px;
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(27px,5vw,40px);
    line-height:1.05;
    color:white;
    text-shadow:0 5px 30px rgba(255,79,163,.25);
}

.promise-close{
    border:1px solid rgba(255,255,255,.25);
    background:rgba(255,255,255,.08);
    color:white;
    padding:11px 22px;
    border-radius:50px;
    font-size:11px;
    letter-spacing:1px;
    transition:.3s;
}

.promise-close:hover{
    background:rgba(255,255,255,.18);
    transform:translateY(-2px);
}

.wish-counter{
    margin-top:18px;
    text-align:center;
    font-size:10px;
    letter-spacing:3px;
    text-transform:uppercase;
    color:rgba(255,255,255,.4);
}

/* =========================================================
   PAGE 7 — CAKE
========================================================= */

.cake-page{
    min-height:100svh;
    background:
        radial-gradient(circle at 50% 30%,#ffe1f1,transparent 35%),
        linear-gradient(135deg,#fff8fc,#ffd7eb);
    display:flex;
    align-items:center;
}

.cake-layout{
    display:grid;
    grid-template-columns:1fr 1fr;
    align-items:center;
    gap:50px;
}

.cake-copy h2{
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(65px,9vw,110px);
    line-height:.78;
    font-weight:500;
}

.cake-copy p{
    margin:25px 0;
    max-width:430px;
    line-height:1.8;
    color:#806271;
}

.cake-scene{
    height:500px;
    position:relative;
    display:flex;
    align-items:flex-end;
    justify-content:center;
    perspective:1200px;
}

.cake-shadow{
    position:absolute;
    bottom:72px;
    width:380px;
    height:50px;
    background:rgba(255,79,163,.17);
    filter:blur(20px);
    border-radius:50%;
    animation:cakeShadow 3s ease-in-out infinite;
}

@keyframes cakeShadow{
    50%{transform:scale(.85);opacity:.65}
}

.cake{
    position:relative;
    width:310px;
    height:270px;
    transform-style:preserve-3d;
    filter:drop-shadow(0 35px 25px rgba(90,20,60,.2));
    animation:cakeFloat 4s ease-in-out infinite;
}

@keyframes cakeFloat{
    0%,100%{transform:translateY(0) rotateY(-2deg)}
    50%{transform:translateY(-8px) rotateY(2deg)}
}

.cake-layer{
    position:absolute;
    left:50%;
    transform:translateX(-50%);
    width:300px;
    border-radius:18px;
    box-shadow:
        inset 0 -12px 20px rgba(120,0,70,.12),
        inset 0 8px 12px rgba(255,255,255,.5);
    transition:1s cubic-bezier(.2,.8,.2,1);
}

.layer-bottom{
    bottom:0;
    height:95px;
    background:
        repeating-linear-gradient(90deg,#ff83bd 0 18px,#ff71b3 18px 36px);
}

.layer-middle{
    bottom:73px;
    height:80px;
    width:260px;
    background:
        repeating-linear-gradient(90deg,#fff 0 18px,#ffd7ea 18px 36px);
}

.layer-top{
    bottom:133px;
    height:70px;
    width:220px;
    background:#fff1f8;
    border-radius:50% 50% 20px 20px;
}

.icing{
    position:absolute;
    width:215px;
    height:45px;
    bottom:154px;
    left:50%;
    transform:translateX(-50%);
    background:white;
    border-radius:50%;
    box-shadow:0 5px 20px rgba(255,79,163,.12);
    z-index:5;
}

.drip{
    position:absolute;
    width:20px;
    height:35px;
    background:white;
    border-radius:0 0 15px 15px;
    top:24px;
}

.drip:nth-child(1){left:25px}
.drip:nth-child(2){left:70px;height:45px}
.drip:nth-child(3){right:50px;height:32px}
.drip:nth-child(4){right:20px;height:42px}

.candle{
    position:absolute;
    bottom:195px;
    width:12px;
    height:55px;
    background:repeating-linear-gradient(
        45deg,
        #ff69ae 0 7px,
        white 7px 14px
    );
    border-radius:6px;
    z-index:6;
}

.c1{left:105px}
.c2{left:150px}
.c3{left:195px}

.flame{
    position:absolute;
    width:16px;
    height:25px;
    top:-24px;
    left:-2px;
    background:#ffb52e;
    border-radius:50% 50% 50% 0;
    transform:rotate(-45deg);
    box-shadow:0 0 25px #ffb52e;
    animation:flame .7s infinite alternate;
}

@keyframes flame{
    to{transform:rotate(-42deg) scale(1.12)}
}

.cake-knife{
    position:absolute;
    right:10%;
    bottom:170px;
    width:180px;
    height:16px;
    background:linear-gradient(#ddd,#fff,#aaa);
    transform:rotate(-55deg);
    transform-origin:right center;
    border-radius:3px;
    transition:1.4s cubic-bezier(.2,.8,.2,1);
    box-shadow:0 4px 10px rgba(0,0,0,.15);
    z-index:10;
}

.cake-knife:after{
    content:"";
    position:absolute;
    right:-70px;
    top:-7px;
    width:75px;
    height:30px;
    background:#2d1830;
    border-radius:8px 18px 18px 8px;
}

.cake-cut .cake-knife{
    transform:rotate(-72deg) translate(-80px,120px);
}

.cake-cut .layer-top{
    transform:translateX(-58%) rotateY(-10deg) translateY(-8px);
}

.cake-cut .layer-middle{
    transform:translateX(-44%) rotateY(7deg);
}

.cake-cut .cake{
    animation:none;
}

.cut-message{
    position:absolute;
    left:50%;
    top:25px;
    transform:translateX(-50%) scale(0);
    font-family:'Great Vibes',cursive;
    font-size:48px;
    color:var(--pink);
    white-space:nowrap;
    z-index:20;
}

.cake-cut .cut-message{
    animation:popMessage .8s forwards .6s;
}

@keyframes popMessage{
    to{
        transform:translateX(-50%) scale(1);
    }
}

/* =========================================================
   PAGE 8 — PHOTO GALLERY
========================================================= */

.gallery{
    background:
        radial-gradient(circle at 50% 10%,rgba(255,79,163,.12),transparent 25%),
        #170712;
    color:white;
    padding:130px 0;
}

.gallery-heading{
    text-align:center;
    margin-bottom:60px;
}

.gallery-heading h2{
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(60px,9vw,110px);
    font-weight:500;
    line-height:.8;
}

.gallery-wrap{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
    perspective:1400px;
}

.gallery-item{
    height:440px;
    overflow:hidden;
    border-radius:25px;
    position:relative;
    transform-style:preserve-3d;
    box-shadow:
        0 25px 60px rgba(0,0,0,.35),
        0 0 0 1px rgba(255,255,255,.08);
    transition:
        transform .7s cubic-bezier(.2,.8,.2,1),
        box-shadow .7s;
    isolation:isolate;
}

.gallery-item:nth-child(even){
    margin-top:70px;
}

.gallery-item img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:1.2s cubic-bezier(.2,.8,.2,1);
    filter:saturate(.9);
}

.gallery-item::before{
    content:"";
    position:absolute;
    inset:0;
    z-index:2;
    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.2),
            transparent 25%,
            transparent 70%,
            rgba(255,79,163,.16)
        );
    pointer-events:none;
    opacity:.7;
}

.gallery-item::after{
    content:"♡";
    position:absolute;
    bottom:18px;
    right:20px;
    font-size:25px;
    color:white;
    opacity:.8;
    z-index:4;
    text-shadow:0 0 15px rgba(255,79,163,.9);
    transition:.4s;
}

.gallery-item:hover{
    transform:
        translateY(-18px)
        rotateX(4deg)
        rotateY(-5deg)
        scale(1.025);
    box-shadow:
        0 40px 90px rgba(0,0,0,.55),
        0 0 40px rgba(255,79,163,.12);
}

.gallery-item:hover img{
    transform:scale(1.13);
    filter:saturate(1.2);
}

.gallery-item:hover::after{
    transform:scale(1.3) rotate(10deg);
}

/* =========================================================
   PAGE 9 — LETTER / ENVELOPE
========================================================= */

.letter-page{
    background:
        radial-gradient(circle at 50% 50%,#fff,#ffe4f2 70%);
    min-height:100svh;
    display:flex;
    align-items:center;
    justify-content:center;
    perspective:1600px;
}

.envelope-area{
    text-align:center;
    perspective:1600px;
}

.envelope{
    width:min(580px,85vw);
    height:370px;
    position:relative;
    margin:45px auto 35px;
    perspective:1400px;
    transform-style:preserve-3d;
}

/*
   Soft 3D shadow underneath the envelope
*/

.envelope::after{
    content:"";
    position:absolute;
    left:8%;
    right:8%;
    bottom:-22px;
    height:35px;
    border-radius:50%;
    background:rgba(140,20,85,.18);
    filter:blur(18px);
    z-index:-5;
    transition:1s ease;
}

.envelope.open::after{
    transform:scale(.82);
    opacity:.65;
}

/*
   Main envelope
*/

.envelope-body{
    position:absolute;
    inset:0;
    background:
        linear-gradient(145deg,#ff8bc4,#ff4fa3 55%,#e92c83);
    border-radius:15px;
    box-shadow:
        0 30px 80px rgba(255,79,163,.25),
        inset 0 1px 0 rgba(255,255,255,.4),
        inset 0 -20px 35px rgba(140,0,65,.12);
    z-index:1;
}

/*
   Envelope lower folds.
   These make the envelope look dimensional.
*/

.envelope-body::before{
    content:"";
    position:absolute;
    inset:0;
    background:
        linear-gradient(
            145deg,
            transparent 49%,
            rgba(150,0,75,.15) 50%,
            transparent 51%
        ),
        linear-gradient(
            35deg,
            transparent 49%,
            rgba(150,0,75,.12) 50%,
            transparent 51%
        );
    border-radius:15px;
    pointer-events:none;
}

/*
   LETTER
   IMPORTANT:
   The letter starts completely INSIDE the envelope.
*/

.letter{
    position:absolute;
    width:82%;
    height:90%;
    left:9%;
    bottom:7px;
    background:
        linear-gradient(145deg,#fff,#fffafa);
    border-radius:10px;
    padding:35px;
    color:#3c2030;
    z-index:3;

    /*
       Closed position:
       tucked down inside envelope.
    */
    transform:
        translate3d(0,58px,-25px)
        rotateX(4deg)
        rotateZ(0deg)
        scale(.96);

    transform-origin:center bottom;

    opacity:.98;

    box-shadow:
        0 10px 25px rgba(0,0,0,.12),
        inset 0 0 0 1px rgba(255,79,163,.06);

    transition:
        transform 1.45s cubic-bezier(.16,.84,.24,1),
        box-shadow 1.2s ease,
        filter 1.2s ease;

    will-change:transform;
}

/*
   Letter paper shine
*/

.letter::before{
    content:"";
    position:absolute;
    inset:0;
    border-radius:10px;
    background:
        linear-gradient(
            115deg,
            transparent 20%,
            rgba(255,255,255,.75) 48%,
            transparent 70%
        );
    transform:translateX(-130%);
    opacity:0;
    pointer-events:none;
}

/*
   OPEN STATE:
   The letter comes UP and OUT of the envelope.
*/

.envelope.open .letter{
    transform:
        translate3d(0,-115px,75px)
        rotateX(0deg)
        rotateZ(-1deg)
        scale(1.015);

    box-shadow:
        0 35px 75px rgba(80,10,45,.22),
        0 0 30px rgba(255,79,163,.12);
    filter:brightness(1.01);
}

.envelope.open .letter::before{
    animation:letterShine 1.6s ease .8s forwards;
}

@keyframes letterShine{
    0%{
        transform:translateX(-130%);
        opacity:0;
    }

    25%{
        opacity:.45;
    }

    100%{
        transform:translateX(130%);
        opacity:0;
    }
}

/*
   Envelope flap
   It sits above the letter when closed.
*/

.envelope-flap{
    position:absolute;
    left:0;
    top:0;
    width:100%;
    height:65%;
    background:
        linear-gradient(145deg,#ffadd2,#ff86bd);
    clip-path:polygon(0 0,100% 0,50% 80%);
    transform-origin:top center;
    z-index:5;

    /*
       Closed state.
    */
    transform:
        rotateX(0deg)
        translateZ(35px);

    backface-visibility:hidden;

    transition:
        transform 1.05s cubic-bezier(.2,.8,.2,1);

    filter:
        drop-shadow(0 5px 8px rgba(130,0,70,.12));

    will-change:transform;
}

/*
   Small highlight on flap
*/

.envelope-flap::after{
    content:"";
    position:absolute;
    left:20%;
    right:20%;
    top:12%;
    height:1px;
    background:rgba(255,255,255,.5);
    opacity:.65;
}

/*
   OPEN FLAP
*/

.envelope.open .envelope-flap{
    transform:
        rotateX(-180deg)
        translateZ(35px);
}

/*
   Letter text
*/

.letter h3{
    font-family:'Great Vibes',cursive;
    color:var(--pink);
    font-size:42px;
    position:relative;
}

.letter p{
    margin-top:20px;
    line-height:1.8;
    font-family:'Cormorant Garamond',serif;
    font-size:21px;
    position:relative;
}

/*
   Letter opening status glow
*/

.envelope.open{
    animation:envelopeOpenPulse 1.5s ease;
}

@keyframes envelopeOpenPulse{

    0%{
        transform:translateY(0) rotateX(0deg);
    }

    25%{
        transform:translateY(-4px) rotateX(1deg);
    }

    60%{
        transform:translateY(0) rotateX(-1deg);
    }

    100%{
        transform:translateY(0) rotateX(0deg);
    }
}

/*
   Button feedback
*/

#letterBtn{
    min-width:190px;
    transition:
        transform .35s,
        box-shadow .35s,
        background .35s;
}

.envelope.open + #letterBtn{
    box-shadow:
        0 15px 45px rgba(255,79,163,.35),
        0 0 25px rgba(255,79,163,.15);
}

/* =========================================================
   PAGE 10 — DREAMS / FUTURE UNIVERSE
========================================================= */

.dreams{
    background:
        radial-gradient(circle at 50% 10%,#9c5cff,transparent 30%),
        linear-gradient(160deg,#120520,#3b124e 55%,#17071f);
    color:white;
    display:flex;
    align-items:center;
    padding:100px 0;
}

.dreams-content{
    text-align:center;
}

.dreams h2{
    font-family:'Cormorant Garamond',serif;
    font-size:clamp(65px,10vw,130px);
    line-height:.75;
    font-weight:500;
}

/*
   UNIVERSE ORBIT

   "us" remains fixed in the center.
   The universe revolves around it.
*/

.constellation{
    width:min(700px,90vw);
    height:380px;
    margin:45px auto;
    position:relative;
    perspective:1200px;
    transform-style:preserve-3d;
}

/*
   Deep atmospheric glow behind the universe
*/

.constellation::after{
    content:"";
    position:absolute;
    left:50%;
    top:50%;
    width:280px;
    height:280px;
    transform:translate(-50%,-50%);
    border-radius:50%;
    background:
        radial-gradient(
            circle,
            rgba(255,145,207,.18),
            rgba(156,92,255,.08) 45%,
            transparent 72%
        );
    filter:blur(10px);
    pointer-events:none;
    animation:universePulse 5s ease-in-out infinite;
}

@keyframes universePulse{

    0%,100%{
        transform:translate(-50%,-50%) scale(.9);
        opacity:.65;
    }

    50%{
        transform:translate(-50%,-50%) scale(1.12);
        opacity:1;
    }
}

/*
   Three-dimensional orbital rings
*/

.orbit-ring{
    position:absolute;
    left:50%;
    top:50%;
    width:72%;
    height:48%;
    border:1px solid rgba(255,255,255,.2);
    border-radius:50%;
    transform-style:preserve-3d;
    pointer-events:none;
}

.orbit-ring.one{
    transform:
        translate(-50%,-50%)
        rotateX(68deg)
        rotateZ(-12deg);
    animation:orbitRotateOne 12s linear infinite;
}

.orbit-ring.two{
    width:62%;
    height:42%;
    border-color:rgba(255,155,213,.2);
    transform:
        translate(-50%,-50%)
        rotateX(62deg)
        rotateZ(48deg);
    animation:orbitRotateTwo 17s linear infinite reverse;
}

.orbit-ring.three{
    width:82%;
    height:55%;
    border-color:rgba(171,119,255,.16);
    transform:
        translate(-50%,-50%)
        rotateX(73deg)
        rotateZ(-48deg);
    animation:orbitRotateThree 22s linear infinite;
}

@keyframes orbitRotateOne{
    from{
        transform:
            translate(-50%,-50%)
            rotateX(68deg)
            rotateZ(-12deg)
            rotate(0deg);
    }

    to{
        transform:
            translate(-50%,-50%)
            rotateX(68deg)
            rotateZ(-12deg)
            rotate(360deg);
    }
}

@keyframes orbitRotateTwo{
    from{
        transform:
            translate(-50%,-50%)
            rotateX(62deg)
            rotateZ(48deg)
            rotate(0deg);
    }

    to{
        transform:
            translate(-50%,-50%)
            rotateX(62deg)
            rotateZ(48deg)
            rotate(-360deg);
    }
}

@keyframes orbitRotateThree{
    from{
        transform:
            translate(-50%,-50%)
            rotateX(73deg)
            rotateZ(-48deg)
            rotate(0deg);
    }

    to{
        transform:
            translate(-50%,-50%)
            rotateX(73deg)
            rotateZ(-48deg)
            rotate(360deg);
    }
}

/*
   Moving planets / stars on the orbit.
*/

.universe-orb{
    position:absolute;
    width:10px;
    height:10px;
    border-radius:50%;
    background:#fff;
    box-shadow:
        0 0 10px #fff,
        0 0 25px #ff8dcc;
    z-index:4;
}

.universe-orb.one{
    left:13%;
    top:47%;
    animation:
        orbitParticleOne 8s linear infinite,
        orbTwinkle 2s ease-in-out infinite;
}

.universe-orb.two{
    right:13%;
    top:30%;
    width:7px;
    height:7px;
    box-shadow:
        0 0 8px #fff,
        0 0 20px #9d5cff;
    animation:
        orbitParticleTwo 11s linear infinite reverse,
        orbTwinkle 2.7s ease-in-out infinite;
}

.universe-orb.three{
    left:48%;
    top:8%;
    width:5px;
    height:5px;
    animation:
        orbitParticleThree 14s linear infinite,
        orbTwinkle 3s ease-in-out infinite;
}

@keyframes orbTwinkle{
    0%,100%{
        opacity:.45;
        transform:scale(.8);
    }

    50%{
        opacity:1;
        transform:scale(1.5);
    }
}

@keyframes orbitParticleOne{
    0%{
        transform:rotate(0deg) translateX(250px) rotate(0deg);
    }

    100%{
        transform:rotate(360deg) translateX(250px) rotate(-360deg);
    }
}

@keyframes orbitParticleTwo{
    0%{
        transform:rotate(0deg) translateX(210px) rotate(0deg);
    }

    100%{
        transform:rotate(-360deg) translateX(210px) rotate(360deg);
    }
}

@keyframes orbitParticleThree{
    0%{
        transform:rotate(0deg) translateX(185px) rotate(0deg);
    }

    100%{
        transform:rotate(360deg) translateX(185px) rotate(-360deg);
    }
}

/*
   Original central "us".
   It remains visually central while the universe
   revolves around it.
*/

.dream-word{
    position:absolute;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    font-family:'Great Vibes',cursive;
    font-size:70px;
    color:#ff9bcf;
    text-shadow:
        0 0 15px rgba(255,255,255,.7),
        0 0 40px rgba(255,100,190,.8),
        0 0 80px rgba(255,100,190,.45);
    z-index:10;
    animation:
        usBreathing 4s ease-in-out infinite,
        usGlow 3s ease-in-out infinite alternate;
    white-space:nowrap;
}

@keyframes usBreathing{

    0%,100%{
        transform:
            translate(-50%,-50%)
            scale(1);
    }

    50%{
        transform:
            translate(-50%,-50%)
            scale(1.06);
    }
}

@keyframes usGlow{

    from{
        text-shadow:
            0 0 15px rgba(255,255,255,.6),
            0 0 35px rgba(255,100,190,.6),
            0 0 65px rgba(255,100,190,.25);
    }

    to{
        text-shadow:
            0 0 20px rgba(255,255,255,.9),
            0 0 50px rgba(255,100,190,1),
            0 0 100px rgba(255,100,190,.55);
    }
}

/*
   Small universe stars
*/

.future-star{
    position:absolute;
    width:3px;
    height:3px;
    border-radius:50%;
    background:white;
    box-shadow:0 0 12px white;
    animation:futureStarTwinkle 2s ease-in-out infinite alternate;
}

.future-star.fs1{left:7%;top:23%;animation-delay:.2s}
.future-star.fs2{left:20%;top:76%;animation-delay:1s}
.future-star.fs3{left:36%;top:13%;animation-delay:1.7s}
.future-star.fs4{right:28%;top:78%;animation-delay:.5s}
.future-star.fs5{right:7%;top:22%;animation-delay:1.3s}
.future-star.fs6{right:17%;bottom:8%;animation-delay:2s}
.future-star.fs7{left:50%;bottom:6%;animation-delay:.8s}
.future-star.fs8{left:5%;top:60%;animation-delay:1.6s}

@keyframes futureStarTwinkle{
    0%{
        opacity:.2;
        transform:scale(.6);
    }

    50%{
        opacity:1;
        transform:scale(1.5);
    }

    100%{
        opacity:.35;
        transform:scale(.8);
    }
}

