/* =========================================================
   DYNAMIC 3D HERO MOUSE MOVEMENT
========================================================= */

window.addEventListener(
    "mousemove",
    e=>{

        if(window.innerWidth<=900)
            return;

        if(!window.gsap)
            return;

        const x=
            e.clientX/
            window.innerWidth-.5;

        const y=
            e.clientY/
            window.innerHeight-.5;

        gsap.to(".hero-title",{
            rotationY:x*8,
            rotationX:-y*5,
            duration:.8,
            ease:"power2.out"
        });

        gsap.to(".photo-orbit",{
            x:x*15,
            y:y*15,
            duration:1,
            ease:"power2.out"
        });

        const starBox=
            document.getElementById(
                "starBox"
            );

        if(starBox){

            const rect=
                starBox.getBoundingClientRect();

            if(
                e.clientX>=rect.left &&
                e.clientX<=rect.right &&
                e.clientY>=rect.top &&
                e.clientY<=rect.bottom
            ){

                const bx=
                    (e.clientX-rect.left)/
                    rect.width-.5;

                const by=
                    (e.clientY-rect.top)/
                    rect.height-.5;

                gsap.to(starBox,{
                    rotateY:bx*3,
                    rotateX:-by*3,
                    duration:.8,
                    ease:"power2.out"
                });

            }

        }

    }
);

