/* =========================================================
   THREE.JS 3D HEART
========================================================= */

const canvas=
    document.getElementById("three-bg");

let renderer;
let scene;
let camera;
let group;
let heart3d;
let clock;

if(canvas && window.THREE){

    renderer=
        new THREE.WebGLRenderer({
            canvas,
            alpha:true,
            antialias:true
        });

    renderer.setPixelRatio(
        Math.min(
            window.devicePixelRatio,
            2
        )
    );

    renderer.setSize(
        window.innerWidth,
        window.innerHeight
    );

    scene=
        new THREE.Scene();

    camera=
        new THREE.PerspectiveCamera(
            45,
            window.innerWidth/
            window.innerHeight,
            .1,
            100
        );

    camera.position.z=7;

    group=
        new THREE.Group();

    scene.add(group);

    const shape=
        new THREE.Shape();

    shape.moveTo(0,1);

    shape.bezierCurveTo(
        -1.6,2.2,
        -3.0,.7,
        0,-2.0
    );

    shape.bezierCurveTo(
        3.0,.7,
        1.6,2.2,
        0,1
    );

    const geometry=
        new THREE.ExtrudeGeometry(
            shape,
            {
                depth:.45,
                bevelEnabled:true,
                bevelSegments:4,
                steps:2,
                bevelSize:.12,
                bevelThickness:.12
            }
        );

    geometry.center();

    const material=
        new THREE.MeshStandardMaterial({
            color:0xff4fa3,
            metalness:.4,
            roughness:.18
        });

    heart3d=
        new THREE.Mesh(
            geometry,
            material
        );

    heart3d.scale.set(
        .55,
        .55,
        .55
    );

    group.add(heart3d);

    for(let i=0;i<3;i++){

        const ringGeo=
            new THREE.TorusGeometry(
                1.8+i*.4,
                .008,
                8,
                100
            );

        const ringMat=
            new THREE.MeshBasicMaterial({
                color:0xffb8dc,
                transparent:true,
                opacity:.4
            });

        const ringMesh=
            new THREE.Mesh(
                ringGeo,
                ringMat
            );

        ringMesh.rotation.x=
            Math.PI/2+i*.5;

        group.add(ringMesh);

    }

    const ambient=
        new THREE.AmbientLight(
            0xffffff,
            1.5
        );

    scene.add(ambient);

    const pinkLight=
        new THREE.PointLight(
            0xff4fa3,
            4,
            10
        );

    pinkLight.position.set(
        3,
        3,
        4
    );

    scene.add(pinkLight);

    const whiteLight=
        new THREE.PointLight(
            0xffffff,
            2,
            10
        );

    whiteLight.position.set(
        -3,
        -2,
        4
    );

    scene.add(whiteLight);

    clock=
        new THREE.Clock();

    function animateThree(){

        requestAnimationFrame(
            animateThree
        );

        const t=
            clock.getElapsedTime();

        if(heart3d){

            heart3d.rotation.x=
                t*.25;

            heart3d.rotation.y=
                t*.45;

        }

        group.position.y=
            Math.sin(t)*.15;

        group.rotation.z=
            Math.sin(t*.3)*.08;

        renderer.render(
            scene,
            camera
        );

    }

    animateThree();

}

