/* =========================================================
   TILT EFFECT — MEMORIES + REASONS
========================================================= */

document
    .querySelectorAll(".memory,.reason")
    .forEach(card=>{

        card.addEventListener(
            "mousemove",
            e=>{

                if(window.innerWidth<=900)
                    return;

                const rect=
                    card.getBoundingClientRect();

                const x=
                    e.clientX-
                    rect.left;

                const y=
                    e.clientY-
                    rect.top;

                const rotateY=
                    (x/rect.width-.5)*12;

                const rotateX=
                    (y/rect.height-.5)*-12;

                card.style.transform=
                    `perspective(900px)
                     rotateX(${rotateX}deg)
                     rotateY(${rotateY}deg)
                     translateY(-8px)`;

