/* =========================================================
   CURVED SHOOTING STAR
========================================================= */

function createShootingStar(){

    if(!starBox) return;

    const star=
        document.createElement("div");

    star.className=
        "shooting-star";

    star.dataset.id=
        starSequence++;

    const startX=
        -180+Math.random()*100;

    const startY=
        35+
        Math.random()*
        Math.max(
            100,
            starBox.clientHeight-150
        );

    const endX=
        starBox.clientWidth+220;

    const endY=
        startY+
        (45+Math.random()*150)*
        (Math.random()>.5?1:-0.25);

    const curveDirection=
        Math.random()>.5?1:-1;

    const curveAmount=
        80+Math.random()*170;

    const controlX=
        startX+
        (endX-startX)*
        (.42+Math.random()*.18);

    const controlY=
        (startY+endY)/2+
        curveDirection*curveAmount;

    const duration=
        9500+Math.random()*5000;

    star.style.left=
        startX+"px";

    star.style.top=
        startY+"px";

    star.style.transform=
        "translate3d(0,0,0) rotate(0deg)";

    starBox.appendChild(star);

    star._path={
        startX,
        startY,
        controlX,
        controlY,
        endX,
        endY
    };

    if(window.gsap){

        const motion={
            progress:0
        };

        const animation=
            gsap.to(motion,{

                progress:1,

                duration:
                    duration/1000,

                ease:"none",

                onUpdate:()=>{

                    if(!star.isConnected)
                        return;

                    const t=
                        motion.progress;

                    const oneMinusT=
                        1-t;

                    const x=
                        oneMinusT*oneMinusT*startX+
                        2*oneMinusT*t*controlX+
                        t*t*endX;

                    const y=
                        oneMinusT*oneMinusT*startY+
                        2*oneMinusT*t*controlY+
                        t*t*endY;

                    const tangentX=
                        2*oneMinusT*
                        (controlX-startX)+
                        2*t*
                        (endX-controlX);

                    const tangentY=
                        2*oneMinusT*
                        (controlY-startY)+
                        2*t*
                        (endY-controlY);

                    const angle=
                        Math.atan2(
                            tangentY,
                            tangentX
                        )*180/Math.PI;

                    star.style.transform=
                        `translate3d(
                            ${x-startX}px,
                            ${y-startY}px,
                            0
                        )
                        rotate(${angle}deg)`;

                },

                onComplete:()=>{

                    if(star.isConnected){
                        star.remove();
                    }

                }

            });

        star._animation=
            animation;

    }

    star.addEventListener("click",e=>{

        e.stopPropagation();

        catchShootingStar(star);

    });

    star.addEventListener(
        "touchstart",
        e=>{

            e.preventDefault();
            e.stopPropagation();

            catchShootingStar(star);

        },
        {passive:false}
    );

}

/* =========================================================
   CATCH STAR
========================================================= */

function catchShootingStar(star){

    if(
        !star ||
        star.classList.contains("catching")
    ){
        return;
    }

    star.classList.add("catching");

    if(star._animation){
        star._animation.kill();
    }

    const rect=
        star.getBoundingClientRect();

    for(let i=0;i<26;i++){

        const particle=
            document.createElement("span");

        particle.className=
            "star-particle";

        document.body.appendChild(particle);

        particle.style.left=
            rect.left+
            rect.width/2+
            "px";

        particle.style.top=
            rect.top+
            rect.height/2+
            "px";

        const angle=
            Math.random()*Math.PI*2;

        const distance=
            35+Math.random()*120;

        if(window.gsap){

            gsap.to(particle,{

                x:
                    Math.cos(angle)*
                    distance,

                y:
                    Math.sin(angle)*
                    distance,

                scale:
                    Math.random()*2+.3,

                opacity:0,

                duration:
                    .8+Math.random()*.5,

                ease:"power2.out",

                onComplete:()=>{
                    particle.remove();
                }

            });

        }else{

            particle.remove();

        }

    }

    if(window.gsap){

        gsap.to(star,{

            scale:1.8,
            opacity:0,
            duration:.65,
            ease:"power2.in",

            onComplete:()=>{

                star.remove();

            }

        });

    }else{

        star.remove();

    }

    if(wishesRemaining.length===0){
        wishesRemaining=[...wishes];
    }

    const randomIndex=
        Math.floor(
            Math.random()*
            wishesRemaining.length
        );

    const wish=
        wishesRemaining.splice(
            randomIndex,
            1
        )[0];

    caughtStars++;

    if(wishCountElement){
        wishCountElement.textContent=
            caughtStars;
    }

    if(promiseMessage){
        promiseMessage.textContent=
            wish;
    }

    if(promiseOverlay){
        promiseOverlay.classList.add("show");
    }

    burstHearts(
        window.innerWidth/2,
        window.innerHeight/2
    );

}

